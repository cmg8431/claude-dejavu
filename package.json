{
  "private": true,
  "type": "module",
  "workspaces": ["packages/cli", "packages/dashboard"],
  "files": [
    ".agents/plugins/marketplace.json",
    "plugin/.claude-plugin",
    "plugin/hooks",
    "plugin/scripts",
    "plugin/skills",
    "packages/cli/dist"
  ],
  "scripts": {
    "build": "cargo build --release -p dejavu-cli && bun run build:cli",
    "build:core": "cargo build --release -p dejavu-cli",
    "build:cli": "bun run --cwd packages/cli build",
    "dev": "cargo run -p dejavu-cli --",
    "dashboard": "bun run --cwd packages/dashboard dev"
  }
}
